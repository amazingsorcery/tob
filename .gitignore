# dependencies
node_modules/
.pnp
.pnp.*

# next
.next/
out/
build/
next-env.d.ts

# production
dist/

# testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# env — NEVER commit real values
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# runtime / generated artefacts
*.tsbuildinfo
.turbo/
backups/
caddy_data/
caddy_config/
.dev-db/
.devpg/

# Agent scratch space. Never part of the build.
.scratch/

# Copied from node_modules by `prebuild` (scripts/copy-maplibre-assets.ts). Generated, not
# authored — and it must be regenerated on every build so it cannot drift from the installed
# maplibre version.
public/maplibre/

# Throwaway verification scripts. Agents write these at the repo root and they should never
# be committed or linted — one broke the lint gate for everyone else mid-build.
tmp-*
.tmp-*
