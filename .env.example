# ---------------------------------------------------------------------------------------
# Deployment configuration — copy to `.env` beside docker-compose.prod.yml and edit.
#
#     cp .env.example .env && chmod 600 .env
#
# Two variables, both read by Caddy, neither secret. The app itself reads no environment;
# pages are generated at build time from content/works/. `.env` is gitignored.
# ---------------------------------------------------------------------------------------

# REQUIRED. Hostname without scheme or trailing slash. Must already resolve (A, and AAAA
# if the box has IPv6) to this server: Caddy requests a certificate on first start.
# Don't add `www.` or a second hostname: failed authorisations count against the rate
# limit and can block the apex certificate.
# The app also has the domain in config/brand.ts (canonical URLs, sitemap); changing
# domains means updating both and rebuilding.
DOMAIN=example.invalid

# REQUIRED. Let's Encrypt contact for expiry warnings if renewal fails. Not published.
ACME_EMAIL=you@example.invalid

# ---------------------------------------------------------------------------------------
# Optional overrides. Everything below has a working default in docker-compose.prod.yml;
# leave these commented out unless you have a reason.
# ---------------------------------------------------------------------------------------

# Let's Encrypt staging (untrusted certs, relaxed rate limits) for testing DNS/firewall
# changes. To switch back, comment out and run
# `docker compose -f docker-compose.prod.yml up -d --force-recreate caddy`.
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Timezone for container logs.
#TZ=UTC

# Compose project and image names. Changing the project name on a live box orphans the
# running containers and the certificate volume.
#COMPOSE_PROJECT_NAME=app
#IMAGE_NAME=app-web
#IMAGE_TAG=current

# Seconds infra/deploy.sh waits for a 200 on `/` before rolling back.
#HEALTH_TIMEOUT=120
