# ---------------------------------------------------------------------------------------
# Deployment configuration — copy to `.env` beside docker-compose.prod.yml and edit.
#
#     cp .env.example .env && chmod 600 .env
#
# THERE ARE TWO VARIABLES AND NEITHER IS A SECRET.
#
# The application reads no environment variable at all. Every page is generated at build
# time from the Markdown in content/works/; there is no database, no session, no API key
# and no outbound request. The two values below are read by Caddy — one to know which
# hostname to get a certificate for, one to give Let's Encrypt a contact address.
#
# That is why there is no command in this file for generating a secret: there is no secret
# to generate. If you find yourself adding a credential here, stop and ask what it is for —
# a static site that needs a credential is a static site that has stopped being one.
#
# `.env` is gitignored. Never commit it, even though nothing in it is confidential today.
# ---------------------------------------------------------------------------------------

# The hostname the site is served on, without a scheme and without a trailing slash.
#
# REQUIRED. Caddy requests a Let's Encrypt certificate for exactly this name on first
# start, so it must already resolve to this server's public IP — both an A record and, if
# the box has IPv6, an AAAA record. `dig +short <name>` from the server is the check.
#
# Do not put `www.` here, and do not add a second hostname: an authorisation failure for a
# name that does not resolve counts against the rate limit for the whole domain and can
# block issuance for the apex too. See docs/deploy/RUNBOOK.md, "Adding a www redirect".
#
# This is the only place the hostname appears in the deployment. Moving the site to another
# domain is an edit here plus `docker compose -f docker-compose.prod.yml up -d caddy`.
# (The application has its own copy of the domain in config/brand.ts, used to build
# canonical URLs and the sitemap at BUILD time. Changing domains means changing both and
# rebuilding — the runbook says so where it matters.)
DOMAIN=example.invalid

# The email address Let's Encrypt associates with the ACME account.
#
# REQUIRED. It is used for one thing: a warning message if a certificate is approaching
# expiry and renewal has been failing. Caddy renews automatically at two thirds of the
# certificate's lifetime, so this address is the last line of defence before a lapse, not
# a routine notification. Use an address a human actually reads.
#
# It is not published anywhere and does not appear on the site.
ACME_EMAIL=you@example.invalid

# ---------------------------------------------------------------------------------------
# Optional overrides. Everything below has a working default in docker-compose.prod.yml;
# leave these commented out unless you have a reason.
# ---------------------------------------------------------------------------------------

# Point ACME at the Let's Encrypt STAGING directory while testing DNS or firewall changes.
# Staging has no meaningful rate limit and issues certificates browsers do not trust — the
# untrusted warning is how you know you are on staging. Production allows only 5 failed
# authorisations per hostname per hour, which is easy to burn during a misconfiguration.
# Comment this back out and run `docker compose -f docker-compose.prod.yml up -d
# --force-recreate caddy` to go back to real certificates.
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Timezone for container logs. UTC by default, and UTC is the right answer for a server.
#TZ=UTC

# Compose project name, and the image name/tag the deploy builds and rolls back between.
# Changing the project name orphans the running containers and the certificate volume, so
# do not change it on a live box without reading docs/deploy/RUNBOOK.md first.
#COMPOSE_PROJECT_NAME=app
#IMAGE_NAME=app-web
#IMAGE_TAG=current

# How long infra/deploy.sh waits for the new container to answer 200 on `/` before it rolls
# back. 120 seconds is generous for a server that starts in under two.
#HEALTH_TIMEOUT=120
