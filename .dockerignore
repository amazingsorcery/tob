# Build context exclusions. Keeps secrets out of the builder layer (`COPY . .`) and keeps
# large directories from busting the cache.
#
# Don't add `public/` or `scripts/`: the builder generates public/katex/ from them.

# --- Dependencies: reinstalled inside the image from the lockfile ---
node_modules
**/node_modules
.pnpm-store
.yarn
.npm

# --- Secrets. Never in a layer. ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
**/*.secret

# --- VCS and CI ---
.git
.gitignore
.gitattributes
.github

# --- Build output: regenerated inside the image ---
.next
out
build
dist
*.tsbuildinfo
next-env.d.ts

# --- Test and tooling artefacts ---
coverage
playwright-report
test-results
blob-report
.playwright
tests/**/__screenshots__
.devpg
.scratch

# --- Infra and docs: not needed for the build ---
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.prod.yml
infra
docs

# --- Manuscript working copies; the site builds from content/works/ ---
MY STUFF

# --- Editor / OS noise ---
.vscode
.idea
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.log
npm-debug.log*
pnpm-debug.log*
tmp-*
.tmp-*
