[Unit]
Description=Periodic health report for the application stack
Requires=docker.service
After=docker.service

[Service]
Type=oneshot

# EDIT to match your checkout and deploy user.
User=deploy
WorkingDirectory=/opt/app

# --quiet logs only problem runs: journalctl -u app-healthcheck.service --since '7 days ago'
# Exit 2 (warnings only) counts as success; exit 1 marks the unit failed.
ExecStart=/opt/app/infra/healthcheck.sh --quiet
SuccessExitStatus=0 2

TimeoutStartSec=3min
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
