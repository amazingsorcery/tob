# Caddy v2 — TLS termination, security headers, reverse proxy to the app container.
#
# {$DOMAIN} and {$ACME_EMAIL} come from .env via docker-compose.prod.yml. To change domain,
# edit .env and run: docker compose -f docker-compose.prod.yml up -d caddy
#
# Validate, then reload without dropping connections:
#     docker compose -f docker-compose.prod.yml exec caddy caddy validate --config /etc/caddy/Caddyfile
#     docker compose -f docker-compose.prod.yml exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	# ACME contact for expiry warnings.
	email {$ACME_EMAIL}

	# Defaults to Let's Encrypt production. Use staging while testing DNS/firewall changes
	# (production allows 5 failed authorisations per hostname per hour):
	#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	acme_ca {$ACME_CA}

	servers {
		# Caddy is the edge, so trusted_proxies stays unset and the client IP is the TCP peer.
		# Behind a CDN, set `trusted_proxies static <cdn-egress-cidr> ...` and make the
		# header_up lines below append instead.
	}
}

{$DOMAIN} {
	# --- Compression ------------------------------------------------------------------
	# Default matcher is fine: there are no streaming responses (text/event-stream would
	# need excluding).
	encode zstd gzip

	# --- Request body limit -----------------------------------------------------------
	# No route reads a body; this just caps abusive uploads. Caddy returns 413 above it.
	request_body {
		max_size 1MB
	}

	# --- Security headers -------------------------------------------------------------
	header {
		# HSTS, 2 years, all subdomains. `preload` only takes effect after submitting at
		# https://hstspreload.org, which is hard to undo for months and covers every
		# subdomain. Only submit once no subdomain will ever need plain HTTP.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

		X-Content-Type-Options "nosniff"

		# Don't leak the referring page to sites linked from bibliographies. Loosen to
		# `same-origin` at most.
		Referrer-Policy "no-referrer"

		# Legacy clickjacking control; CSP frame-ancestors covers modern browsers.
		X-Frame-Options "DENY"

		# Disable unused browser features. `browsing-topics=()` opts out of Chrome's Topics API.
		Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"

		# COOP stops linked pages reaching window.opener; CORP stops cross-origin embedding.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# Disable the legacy XSS auditor (itself exploitable).
		X-XSS-Protection "0"

		-Server
		-X-Powered-By

		# --- Content Security Policy ---------------------------------------------------
		# Prerendered HTML, self-hosted CSS/fonts/KaTeX and the Next.js runtime; no
		# third-party origins. Re-verify against a production build after Next.js upgrades.
		#
		# Strict:
		#   default-src 'self'      covers media, workers, manifests (none are used).
		#   base-uri 'none'         blocks <base href> injection.
		#   object-src, frame-src, frame-ancestors 'none'.
		#   form-action 'none'      there are no forms.
		#   font-src 'self'         next/font self-hosts at build time; KaTeX fonts in /katex/fonts/.
		#   connect-src 'self'      App Router .rsc prefetches.
		#   script-src-attr 'none'  no inline handlers in the HTML; blocks injected onerror= etc.
		#   style-src-elem 'self'   no inline <style> (experimental.inlineCss is off).
		#
		# Loosened:
		#   script-src 'unsafe-inline'  the App Router inlines RSC payload scripts
		#       (self.__next_f.push) that differ per page, so hashes aren't practical, and
		#       nonces would force dynamic rendering. Content is committed Markdown rendered
		#       with HTML escaped and no dangerouslySetInnerHTML.
		#   style-src / style-src-attr 'unsafe-inline'  KaTeX positions glyphs with inline
		#       style attributes. style-src also carries it for browsers without -elem/-attr
		#       support (Safari < 15.4).
		#   img-src data:  not needed today; kept so a favicon or inline SVG isn't silently
		#       blocked.
		#
		# Not set: report-uri/report-to (no endpoint to receive reports),
		# require-trusted-types-for (breaks React DOM writes). KaTeX runs at build time
		# only and adds no client JS.
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'none'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; upgrade-insecure-requests"
	}

	# --- Access log -------------------------------------------------------------------
	log {
		# stdout, rotated by Docker's json-file driver (see docker-compose.prod.yml).
		output stdout

		format filter {
			wrap json

			fields {
				# Already redacted by default; explicit in case defaults change.
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete

				# Mask client IPs (/24 IPv4, /48 IPv6): enough to spot abusive networks,
				# not enough to identify individual readers.
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}

	# --- Reverse proxy ----------------------------------------------------------------
	# `web` resolves on the internal `site` network; port 3000 isn't published to the host.
	reverse_proxy web:3000 {
		# Overwrite rather than append, so client-supplied forwarding headers never reach the app.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# Caddy's default already preserves Host; explicit for clarity.
		header_up Host {host}

		# dial_timeout: app down/restarting. response_header_timeout: app accepted but hung.
		# Responses are prerendered files, so 15s is generous.
		transport http {
			dial_timeout 5s
			response_header_timeout 15s
		}
	}

	# --- Error pages ------------------------------------------------------------------
	# Plain-text status instead of Caddy's empty body when the app is unreachable.
	handle_errors {
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

# No www redirect. Before adding `www.{$DOMAIN}`, create its DNS record; failed ACME
# authorisations count against the rate limit and can block the apex certificate too.
